# PostgreSQL local de desarrollo. No uses estos valores en producción.
POSTGRES_DB="mentorify_platform"
POSTGRES_USER="mentorify_dev"
POSTGRES_PASSWORD="REEMPLAZAR_CON_CLAVE_LOCAL"
DATABASE_URL="postgresql://mentorify_dev:REEMPLAZAR_CON_CLAVE_LOCAL@localhost:5432/mentorify_platform?schema=public"
SESSION_SECRET="REEMPLAZAR_CON_64_CARACTERES_ALEATORIOS"
DEMO_PASSWORD="REEMPLAZAR_CON_CLAVE_DEMO_LOCAL"

# MentoriFY Communication Core — Meta WhatsApp (bloque 32). Credenciales de LA PLATAFORMA (nuestra app de Meta),
# nunca de un tenant individual — los datos de cada empresa (WABA, phone_number_id, token) se guardan cifrados
# en WhatsAppConnection/WhatsAppPhoneNumber al conectar, no aquí.
# NEXT_PUBLIC_META_APP_ID y NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID son públicas por diseño (Meta las exige
# en el navegador para cargar el SDK y abrir Embedded Signup) — META_APP_SECRET NUNCA debe llevar ese prefijo.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
INTEGRATION_ENCRYPTION_KEY=
